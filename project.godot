; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Connect 4 Pop Out"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07058824, 0.07058824, 0.07058824, 1)
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameSettings="*res://autoloads/game_settings.gd"
SceneSwitcher="*res://autoloads/scene_switcher.gd"
AudioManager="*res://autoloads/audio_manager.gd"
UiSounds="*res://autoloads/ui_sounds.gd"
UiIntro="*res://autoloads/ui_intro.gd"
Net="*res://net/net_client.gd"
Rooms="*res://net/room_client.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/themes/main_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07058824, 0.07058824, 0.07058824, 1)
2d/snap/snap_2d_transforms_to_pixel=true
