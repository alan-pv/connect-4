[node name="HelpTitle" type="RichTextLabel" parent="HelpPanel/Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
bbcode_enabled = true
text = "[center][tornado radius=3 freq=2]How to play"
fit_content = true
scroll_active = false

[node name="HelpText" type="Label" parent="HelpPanel/Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.69803923, 0.69803923, 0.69803923, 0.78)
theme_override_font_sizes/font_size = 19
text = "Take turns dropping a disc into a column. It falls to the lowest free slot. Four of your colour in a row wins the round: across, down, or corner to corner.

Turn POP OUT on and a turn can be spent the other way instead. The buttons under the board pull your own disc out of the bottom row, and everything stacked above it drops one slot. Only your own colour, and only from the bottom.

That cuts both ways. A column falling into place settles six slots at once, and the four it completes might be your opponent's. Pop one into their line and they take the round. Complete a four for each of you in the same move and nobody does.

Whoever wins enough rounds takes the match."
autowrap_mode = 3

[node name="CloseHelpButton" type="Button" parent="HelpPanel/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GreenButton"
text = "Got it"
